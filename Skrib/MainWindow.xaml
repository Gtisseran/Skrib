<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Skrib.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Skrib"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Skrib">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="AppTitleBar"
                Grid.Row="0"
                Height="32"
                Padding="8,0,12,0"
                Background="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <Image Width="16" Height="16" Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" Stretch="Uniform" />
                    <TextBlock x:Name="WindowTitleText" Text="Skrib" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="WindowTitleStatus"
                           Text="Sans titre"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!-- MAIN EDITOR VIEW -->
        <Grid x:Name="MainView" Grid.Row="1" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <MenuBar Grid.Column="0">
                    <MenuBarItem x:Name="MenuFile" Title="Fichier">
                        <MenuFlyoutItem x:Name="MenuNew" Text="Nouveau" Click="NewFile_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8A5;" />
                            </MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="N" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuOpen" Text="Ouvrir..." Click="OpenFile_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xED25;" />
                            </MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="O" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuSave" Text="Enregistrer" Click="SaveFile_Click">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Save" />
                            </MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="S" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuSaveAs" Text="Enregistrer sous..." Click="SaveAsFile_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE792;" />
                            </MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="S" Modifiers="Control,Shift" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="MenuExit" Text="Quitter" Click="Exit_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE711;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuBarItem>
                    <MenuBarItem x:Name="MenuEdit" Title="Édition">
                        <MenuFlyoutItem x:Name="MenuUndo" Text="Annuler" Click="Undo_Click">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Undo" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuRedo" Text="Rétablir" Click="Redo_Click">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Redo" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="MenuCut" Text="Couper" Click="Cut_Click">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Cut" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuCopy" Text="Copier" Click="Copy_Click">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Copy" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuPaste" Text="Coller" Click="Paste_Click">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Paste" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="MenuSelectAll" Text="Tout sélectionner" Click="SelectAll_Click">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="SelectAll" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuBarItem>
                </MenuBar>

                <Button Grid.Column="1"
                        x:Name="SettingsButton"
                        Click="SettingsButton_Click"
                        Margin="0,2,8,2"
                        Padding="8,6"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="4"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        ToolTipService.ToolTip="Paramètres">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
            </Grid>

            <TextBox x:Name="Editor" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="14" TextChanged="Editor_TextChanged" SelectionChanged="Editor_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <TextBox.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF"/>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF"/>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF"/>
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Dark">
                                <SolidColorBrush x:Key="TextControlBackground" Color="#202020"/>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#202020"/>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#202020"/>
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </TextBox.Resources>
            </TextBox>

            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="10,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon x:Name="StatusIcon" Glyph="&#xE7C3;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="Prêt" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="CaretInfoText" Text="Ln 1, Col 1" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- SETTINGS PAGE (NOTEPAD STYLE) -->
        <Grid x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: back button + large title, like Windows Notepad -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Padding="20,16,20,12" VerticalAlignment="Center">
                <Button x:Name="BackButton"
                        Click="BackButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6,4"
                        CornerRadius="6"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Retour">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <TextBlock x:Name="SettingsTitleText"
                           Text="Paramètres"
                           FontSize="28"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Content: responsive (side-by-side when wide, stacked when narrow) -->
            <ScrollViewer Grid.Row="1" Padding="20,0,20,24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="SettingsContentGrid" ColumnSpacing="24" RowSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="AboutColumn" Width="300" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="SettingsWideState">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="880" />
                                </VisualState.StateTriggers>
                            </VisualState>
                            <VisualState x:Name="SettingsNarrowState">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="0" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="AboutColumn.Width" Value="0" />
                                    <Setter Target="SettingsAboutColumn.(Grid.Row)" Value="1" />
                                    <Setter Target="SettingsAboutColumn.(Grid.Column)" Value="0" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>

                    <StackPanel x:Name="SettingsMainColumn" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Stretch" Spacing="24">

                        <!-- Appearance -->
                        <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                            <TextBlock x:Name="SectionAppearanceTitle" Text="Apparence" FontSize="14" FontWeight="SemiBold" Margin="4,0,0,4" />

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    MinHeight="76"
                                    Padding="16,12"
                                    HorizontalAlignment="Stretch">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE790;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock x:Name="ThemeHeaderTitle" Text="Thème de l'application" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock x:Name="ThemeHeaderDesc" Text="Choisissez le thème à afficher dans Skrib" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <ComboBox Grid.Column="2" x:Name="ThemeComboBox"
                                              SelectionChanged="ThemeComboBox_SelectionChanged"
                                              Width="280"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center">
                                        <ComboBoxItem Tag="Light">
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE706;" FontSize="16" VerticalAlignment="Center" />
                                                <TextBlock x:Name="ThemeLightComboText" Text="Clair" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="Dark">
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE708;" FontSize="16" VerticalAlignment="Center" />
                                                <TextBlock x:Name="ThemeDarkComboText" Text="Sombre" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="Default">
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE770;" FontSize="16" VerticalAlignment="Center" />
                                                <TextBlock x:Name="ThemeSystemComboText" Text="Utiliser le thème du système" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    MinHeight="76"
                                    Padding="16,12"
                                    HorizontalAlignment="Stretch">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE775;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock x:Name="LangHeaderTitle" Text="Langue" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock x:Name="LangHeaderDesc" Text="Choisissez la langue de l'application" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <ComboBox Grid.Column="2" x:Name="LangComboBox"
                                              SelectionChanged="LangComboBox_SelectionChanged"
                                              Width="240"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center">
                                        <ComboBoxItem Tag="fr">
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <Border Width="22" Height="15" CornerRadius="2" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Center">
                                                    <Image Source="ms-appx:///Assets/Flags/fr.png" Stretch="Fill" />
                                                </Border>
                                                <TextBlock x:Name="LangFrComboText" Text="Français (FR)" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="en">
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <Border Width="22" Height="15" CornerRadius="2" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Center">
                                                    <Image Source="ms-appx:///Assets/Flags/en.png" Stretch="Fill" />
                                                </Border>
                                                <TextBlock x:Name="LangEnComboText" Text="English (EN)" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Editor -->
                        <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                            <TextBlock x:Name="SectionEditorTitle" Text="Éditeur" FontSize="14" FontWeight="SemiBold" Margin="4,0,0,4" />

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    MinHeight="76"
                                    Padding="16,12"
                                    HorizontalAlignment="Stretch">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE751;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock x:Name="WordWrapTitle" Text="Retour automatique à la ligne" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock x:Name="WordWrapDesc" Text="Ajuster le texte pour qu'il tienne dans la largeur de la fenêtre" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock x:Name="WordWrapStateText" Text="Activé" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Width="70" TextAlignment="Right" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <ToggleSwitch x:Name="WordWrapToggle"
                                                      IsOn="True"
                                                      Toggled="WordWrapToggle_Toggled"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,4,0"
                                                      MinWidth="0"
                                                      OnContent="" OffContent="" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                    </StackPanel>

                    <!-- Right about panel, like Windows Notepad (moves below when narrow) -->
                    <StackPanel x:Name="SettingsAboutColumn" Grid.Column="1" Grid.Row="0" Spacing="8" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <TextBlock x:Name="SectionAboutTitle" Text="À propos de cette application" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinHeight="76"
                            Padding="16,12"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    VerticalAlignment="Center">
                                <Image Source="ms-appx:///Assets/Square44x44Logo.targetsize-24.png" Width="24" Height="24"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="AboutTitle" Text="Skrib" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                <TextBlock x:Name="AboutDesc" Text="Version" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button x:Name="GitHubButton"
                            Click="GitHubButton_Click"
                            HorizontalAlignment="Stretch"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" Fill="{ThemeResource TextFillColorPrimaryBrush}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" /></Viewbox>
                            <TextBlock x:Name="GitHubButtonText" Text="Voir sur GitHub" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="StoreButton"
                            Click="StoreButton_Click"
                            HorizontalAlignment="Stretch"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE7B8;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock x:Name="StoreButtonText" Text="Vérifier les mises à jour" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="RateButton"
                            Click="RateButton_Click"
                            HorizontalAlignment="Stretch"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE734;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock x:Name="RateButtonText" Text="Noter Skrib" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="FeedbackButton"
                            Click="FeedbackButton_Click"
                            HorizontalAlignment="Stretch"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8BD;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock x:Name="FeedbackButtonText" Text="Envoyer un commentaire" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>