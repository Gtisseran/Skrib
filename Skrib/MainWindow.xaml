<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Skrib.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Skrib"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Skrib">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" KeyDown="RootGrid_KeyDown">
        <!-- MAIN EDITOR VIEW -->
        <Grid x:Name="MainView" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top row: MenuBar + Settings button at the end -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <MenuBar Grid.Column="0">
                    <MenuBarItem x:Name="MenuFile" Title="Fichier">
                        <MenuFlyoutItem x:Name="MenuNew" Text="Nouveau" Click="NewFile_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8A5;" />
                            </MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="N" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuOpen" Text="Ouvrir..." Click="OpenFile_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xED25;" />
                            </MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="O" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuSave" Text="Enregistrer" Click="SaveFile_Click">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Save" />
                            </MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="S" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuSaveAs" Text="Enregistrer sous..." Click="SaveAsFile_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE792;" />
                            </MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="S" Modifiers="Control,Shift" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="MenuExit" Text="Quitter" Click="Exit_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE711;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuBarItem>
                    <MenuBarItem x:Name="MenuEdit" Title="Édition">
                        <MenuFlyoutItem x:Name="MenuCut" Text="Couper" Click="Cut_Click">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Cut" />
                            </MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="X" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuCopy" Text="Copier" Click="Copy_Click">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Copy" />
                            </MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="C" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuPaste" Text="Coller" Click="Paste_Click">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Paste" />
                            </MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="V" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="MenuSelectAll" Text="Tout sélectionner" Click="SelectAll_Click">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="SelectAll" />
                            </MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="A" Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                    </MenuBarItem>
                </MenuBar>

                <!-- Settings button: icon-only, at row end -->
                <Button Grid.Column="1"
                        x:Name="SettingsButton"
                        Click="SettingsButton_Click"
                        Margin="0,2,8,2"
                        Padding="8,6"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="4"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        ToolTipService.ToolTip="Paramètres">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
            </Grid>

            <!-- Editor text area -->
            <TextBox x:Name="Editor" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="14" TextChanged="Editor_TextChanged" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <TextBox.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF"/>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF"/>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF"/>
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Dark">
                                <SolidColorBrush x:Key="TextControlBackground" Color="#202020"/>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#202020"/>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#202020"/>
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </TextBox.Resources>
            </TextBox>

            <!-- Status bar with icon -->
            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="10,4">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon x:Name="StatusIcon" Glyph="&#xE7C3;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="Prêt" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- SETTINGS PAGE (WINDOWS 11 STYLE) -->
        <Grid x:Name="SettingsView" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Settings header: back button + title -->
            <Grid Grid.Row="0" Margin="10,12,20,8" Padding="0,0,0,8">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="8,6"
                        HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BackButton"
                                Grid.Column="0"
                                Click="BackButton_Click"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                BorderThickness="0"
                                Padding="8,6"
                                CornerRadius="8"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Retour">
                            <FontIcon Glyph="&#xE72B;" FontSize="16" />
                        </Button>

                        <TextBlock x:Name="SettingsTitleText"
                                   Grid.Column="1"
                                   Text="Paramètres"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Settings content using Win11-style cards and dropdowns -->
            <ScrollViewer Grid.Row="1" Padding="20,0,20,24">
                 <StackPanel MaxWidth="860" HorizontalAlignment="Left" Spacing="20">

                    <!-- SECTION 1: APPEARANCE -->
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="SectionAppearanceTitle" Text="Apparence" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="4,0,0,4" />

                        <!-- Theme card with ComboBox (dropdown menu) -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                MinHeight="68"
                                Padding="16,12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE790;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="ThemeHeaderTitle" Text="Thème de l'application" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock x:Name="ThemeHeaderDesc" Text="Choisissez le thème à afficher dans Skrib" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <ComboBox Grid.Column="2" x:Name="ThemeComboBox"
                                          SelectionChanged="ThemeComboBox_SelectionChanged"
                                          Width="280"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center"
                                          Padding="10,8,10,8">
                                    <ComboBoxItem Tag="Light" VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch" Padding="10,8,10,8">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE706;" FontSize="16" VerticalAlignment="Center" />
                                            <TextBlock x:Name="ThemeLightComboText" Text="Clair" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="Dark" VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch" Padding="10,8,10,8">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE708;" FontSize="16" VerticalAlignment="Center" />
                                            <TextBlock x:Name="ThemeDarkComboText" Text="Sombre" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="Default" VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch" Padding="10,8,10,8">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE770;" FontSize="16" VerticalAlignment="Center" />
                                            <TextBlock x:Name="ThemeSystemComboText" Text="Utiliser le thème du système" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="170" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Language card with ComboBox (dropdown) and flags -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                MinHeight="68"
                                Padding="16,12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE775;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="LangHeaderTitle" Text="Langue" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock x:Name="LangHeaderDesc" Text="Choisissez la langue de l'application" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <ComboBox Grid.Column="2" x:Name="LangComboBox"
                                          SelectionChanged="LangComboBox_SelectionChanged"
                                          MinWidth="240"
                                          VerticalContentAlignment="Center"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center">
                                    <!-- French option with flag -->
                                    <ComboBoxItem Tag="fr" VerticalContentAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Border Width="22" Height="15" CornerRadius="2" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Center">
                                                <Image Source="ms-appx:///Assets/Flags/fr.png" Stretch="Fill" />
                                            </Border>
                                            <TextBlock x:Name="LangFrComboText" Text="Français (FR)" VerticalAlignment="Center" FontWeight="Medium" />
                                        </StackPanel>
                                    </ComboBoxItem>

                                    <!-- English option with flag -->
                                    <ComboBoxItem Tag="en" VerticalContentAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Border Width="22" Height="15" CornerRadius="2" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Center">
                                                <Image Source="ms-appx:///Assets/Flags/en.png" Stretch="Fill" />
                                            </Border>
                                            <TextBlock x:Name="LangEnComboText" Text="English (EN)" VerticalAlignment="Center" FontWeight="Medium" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                </ComboBox>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- SECTION 2: EDITOR -->
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="SectionEditorTitle" Text="Éditeur" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="4,0,0,4" />

                        <!-- Word wrap card with ToggleSwitch -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                MinHeight="68"
                                Padding="16,12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE751;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="WordWrapTitle" Text="Retour automatique à la ligne" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock x:Name="WordWrapDesc" Text="Ajuster le texte pour qu'il tienne dans la largeur de la fenêtre" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <ToggleSwitch Grid.Column="2" x:Name="WordWrapToggle"
                                              IsOn="True"
                                              Toggled="WordWrapToggle_Toggled"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,4,0"
                                              MinWidth="0"
                                              OnContent="" OffContent="" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- SECTION 3: UPDATES (handled by Microsoft Store) -->
                    <StackPanel Spacing="8" Visibility="Collapsed">
                        <TextBlock x:Name="SectionUpdateTitle" Text="Mises à jour" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="4,0,0,4" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                MinHeight="68"
                                Padding="16,12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE895;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="UpdateHeaderTitle" Text="Mises à jour" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock x:Name="UpdateHeaderDesc" Text="Vérifiez si une nouvelle version est disponible" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <Button Grid.Column="2"
                                        x:Name="CheckUpdateButton"
                                        Click="CheckUpdateButton_Click"
                                        Style="{StaticResource AccentButtonStyle}"
                                        MinWidth="128"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ProgressRing x:Name="UpdateCheckProgress"
                                                      Width="16"
                                                      Height="16"
                                                      IsActive="False"
                                                      Visibility="Collapsed" />
                                        <TextBlock x:Name="CheckUpdateButtonText" Text="Vérifier" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <InfoBar x:Name="UpdateInfoBar"
                                  IsOpen="False"
                                  IsClosable="True"
                                  Severity="Informational" />

                        <TextBlock x:Name="BetaNoticeText"
                                    Text="Version stable"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Margin="4,0,0,0" />
                    </StackPanel>

                    <!-- SECTION 4: ABOUT -->
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="SectionAboutTitle" Text="À propos" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="4,0,0,4" />

                        <!-- About Skrib card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                MinHeight="68"
                                Padding="16,12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        VerticalAlignment="Center">
                                    <Image Source="ms-appx:///Assets/Square44x44Logo.targetsize-24.png" Width="24" Height="24"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="AboutTitle" Text="Skrib" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock x:Name="AboutDesc" Text="Version" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

